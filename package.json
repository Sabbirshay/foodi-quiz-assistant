{
  "name": "foodi-quiz-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "worker": "node scripts/local-worker.mjs",
    "bootstrap": "tsx --env-file=.env.local scripts/bootstrap-admin.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src worker/src scripts tests"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "cron-parser": "5.10.1",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.38.1",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
